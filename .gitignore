# Local-only tooling. Cloudflare Pages publishes everything committed here, so
# anything tracked becomes downloadable at mycampuskorner.com/<path>.
#
# NOTE: build_listings.py, admin/, functions/ and .github/ are deliberately NOT
# ignored -- the GitHub Action runs build_listings.py, and the hosted editor is
# admin/index.html guarded by functions/.

# The local editor server (writes to your disk; useless and confusing if served)
catalog_server.py
build_listings_old.py

# Safety copies: local, and they grow forever
js/backups/
js/products.backup.js
js/products.real.js

# Test catalog: a snapshot of the real one, so it goes stale and just
# duplicates js/products.js in the repo
js/products.sample.js

# Local test runs of `wrangler pages dev` (cache and local database state)
.wrangler/

# The local dev server and its regression suite (tools/dev-server.mjs,
# tools/test.mjs). They run the site and the editor on this machine and are
# not part of serving it, so they stay out of the repo -- Cloudflare Pages
# publishes everything that IS committed, and nothing here needs to be
# reachable at mycampuskorner.com/tools/.
#
# They live in the working folder instead. Keep that folder: a fresh clone
# will not have them. admin/HANDOVER.md explains how to use them, and if you
# would rather have them version-controlled, move them to admin/tools/ --
# everything under admin/ is behind the editor password.
tools/

# Python / OS noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
